SECRET_KEY=change-me-to-a-random-string
DATABASE_URL=sqlite:///db.sqlite3

# UPS Rating API (OAuth client credentials). Leave unset to use the
# built-in flat-rate shipping estimator instead.
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=
UPS_ENV=test

# Anthropic API key for the AI shopping assistant. Leave unset to use the
# built-in rule-based fallback responder instead.
ANTHROPIC_API_KEY=
