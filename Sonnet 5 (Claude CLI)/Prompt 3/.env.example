# --- Core ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-64-char-hex-string
ENVIRONMENT=development
# Set to true only behind HTTPS (production)
SESSION_COOKIE_SECURE=false

# --- Database ---
DATABASE_URL=postgresql+psycopg://marketplace:marketplace@db:5432/marketplace

# --- UPS Rating API (https://developer.ups.com) ---
# Create an app in the UPS developer portal to get these. Sandbox and
# production use different base URLs/credentials.
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=
UPS_ENV=sandbox
# Ship-from address is fixed per business requirements (see app/services/shipping.py)

# --- AI chatbot (Anthropic) ---
ANTHROPIC_API_KEY=

# --- Uploads ---
MAX_UPLOAD_MB=5
