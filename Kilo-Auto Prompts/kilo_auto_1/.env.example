# ----------------------------------------------------------
# Application
# ----------------------------------------------------------
APP_NAME=Kilo Marketplace
APP_ENV=development
DEBUG=true
# Secret key used to sign JWT tokens (use openssl rand -hex 32 in production)
SECRET_KEY=dev-secret-key-change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ----------------------------------------------------------
# Database
# ----------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./marketplace.db

# ----------------------------------------------------------
# Redis / Background tasks
# ----------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ----------------------------------------------------------
# AI Chatbot
# ----------------------------------------------------------
# If OPENAI_API_KEY is set the chatbot uses GPT; otherwise a
# rules-based fallback engine is used.
OPENAI_API_KEY=
CHATBOT_FALLBACK_MODEL=gpt-4o-mini

# ----------------------------------------------------------
# UPS Shipping
# ----------------------------------------------------------
UPS_ORIGIN_ADDRESS=110 Inner Campus Drive
UPS_ORIGIN_CITY=Austin
UPS_ORIGIN_STATE=TX
UPS_ORIGIN_ZIP=78705
UPS_ORIGIN_COUNTRY=US
UPS_FUEL_SURCHARGE_RATE=0.078
UPS_RESIDENTIAL_SURCHARGE=4.20
UPS_MIN_CHARGE_GROUND=6.50

# ----------------------------------------------------------
# File uploads
# ----------------------------------------------------------
UPLOAD_DIR=app/static/uploads
MAX_UPLOAD_SIZE=5242880
