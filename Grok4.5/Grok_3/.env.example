# REQUIRED: generate with `openssl rand -hex 32`
SECRET_KEY=replace-with-a-long-random-string-min-32-chars

# SQLite for local; use PostgreSQL in production, e.g.:
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/marketplace
DATABASE_URL=sqlite:///./marketplace.db

ACCESS_TOKEN_EXPIRE_MINUTES=60
OPENAI_API_KEY=
UPLOAD_DIR=uploads
ORIGIN_ADDRESS=110 Inner Campus Drive, Austin, TX 78705
ORIGIN_ZIP=78705

# Production: set to your real domain(s), never "*"
CORS_ORIGINS=http://localhost:8000
