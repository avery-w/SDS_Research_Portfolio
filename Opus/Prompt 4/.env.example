# Copy to .env and fill in. Never commit .env.
DOMAIN=shop.example.com
DJANGO_ALLOWED_HOSTS=shop.example.com
# python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_ADMIN_URL=manage-change-me/
DJANGO_DEBUG=0

POSTGRES_DB=marketplace
POSTGRES_USER=marketplace
POSTGRES_PASSWORD=
POSTGRES_HOST=db

# Claude chatbot
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5

# UPS Rating API (developer.ups.com). Blank = built-in estimator.
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=
UPS_BASE_URL=https://onlinetools.ups.com
UPS_FUEL_SURCHARGE_PCT=16

# SMTP for password reset emails. Blank = print to console.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@shop.example.com
