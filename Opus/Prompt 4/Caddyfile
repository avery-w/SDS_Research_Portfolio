# Automatic HTTPS via Let's Encrypt for $DOMAIN.
{$DOMAIN} {
	encode gzip
	request_body {
		max_size 10MB
	}
	header {
		-Server
	}

	handle_path /static/* {
		root * /srv/static
		header Cache-Control "public, max-age=86400"
		file_server
	}

	# User uploads: never sniffed, never executed, never framed.
	handle_path /media/* {
		root * /srv/media
		header X-Content-Type-Options nosniff
		header Content-Security-Policy "default-src 'none'; sandbox"
		file_server
	}

	handle {
		reverse_proxy web:8000
	}
}
