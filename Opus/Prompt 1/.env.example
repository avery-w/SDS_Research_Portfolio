# Copy to .env and fill in. Flask loads .env automatically when python-dotenv is installed.
FLASK_APP=marketplace
SECRET_KEY=change-me-to-a-long-random-string
# Defaults to SQLite in instance/marketplace.db. For PostgreSQL: postgresql+psycopg://user:pass@localhost/marketplace
# DATABASE_URL=
# Set to 1 when serving over HTTPS
SESSION_COOKIE_SECURE=0

# AI assistant (Claude). Without a key the assistant answers from the product database only.
ANTHROPIC_API_KEY=
CHAT_MODEL=claude-opus-5

# UPS Rating API (developer.ups.com). Without these, checkout uses the built-in UPS-guideline estimator.
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
UPS_ACCOUNT_NUMBER=
# https://wwwcie.ups.com is the UPS test environment; use https://onlinetools.ups.com in production.
UPS_BASE_URL=https://wwwcie.ups.com
UPS_API_VERSION=v2409
